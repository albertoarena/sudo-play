diff --git a/resources/electron/electron-plugin/dist/server/phpServerWatchdog.js b/resources/electron/electron-plugin/dist/server/phpServerWatchdog.js
new file mode 100644
--- /dev/null
+++ b/resources/electron/electron-plugin/dist/server/phpServerWatchdog.js
@@ -0,0 +1,43 @@
+// Sudo Play patch: decides what to do when the php -S server exits.
+// Pure on purpose (no Electron imports) so it can be tested on its own.
+export const RESTART_DELAY_MS = 1000;
+export const MAX_RECOVERIES = 3;
+export const RECOVERY_WINDOW_MS = 5 * 60 * 1000;
+export function createPhpServerWatchdog({ now = Date.now, history = [] } = {}) {
+    let quitting = false;
+    let recoveries = Array.isArray(history)
+        ? history.filter((time) => typeof time === 'number')
+        : [];
+    function prune() {
+        recoveries = recoveries.filter((time) => now() - time < RECOVERY_WINDOW_MS);
+    }
+    function recover(action) {
+        if (quitting) {
+            return 'ignore';
+        }
+        prune();
+        if (recoveries.length >= MAX_RECOVERIES) {
+            return 'give-up';
+        }
+        recoveries.push(now());
+        return action;
+    }
+    return {
+        markQuitting() {
+            quitting = true;
+        },
+        isQuitting() {
+            return quitting;
+        },
+        onExit() {
+            return recover('restart');
+        },
+        onRestartFailed() {
+            return recover('relaunch');
+        },
+        history() {
+            prune();
+            return [...recoveries];
+        },
+    };
+}
