diff --git a/resources/electron/electron-plugin/dist/server/electronLog.js b/resources/electron/electron-plugin/dist/server/electronLog.js
new file mode 100644
--- /dev/null
+++ b/resources/electron/electron-plugin/dist/server/electronLog.js
@@ -0,0 +1,43 @@
+// Sudo Play patch: copies the console to a log file. In a packaged app the
+// console goes nowhere, so without this an exit of the PHP server leaves no
+// trace. The file stays on this Mac, and is rotated at about 1 MB.
+import { appendFileSync, mkdirSync, renameSync, statSync } from 'fs';
+import { dirname } from 'path';
+import { format } from 'util';
+export const MAX_LOG_BYTES = 1024 * 1024;
+const LEVELS = { log: 'INFO', info: 'INFO', warn: 'WARNING', error: 'ERROR' };
+export function createLogFile(file, { maxBytes = MAX_LOG_BYTES, now = () => new Date() } = {}) {
+    const oldFile = file.replace(/\.log$/, '.old.log');
+    return function write(level, args) {
+        if (args.length === 0) {
+            return;
+        }
+        try {
+            const line = `[${now().toISOString()}] ${level}: ${format(...args)}\n`;
+            mkdirSync(dirname(file), { recursive: true });
+            let size = 0;
+            try {
+                size = statSync(file).size;
+            }
+            catch (_a) {
+                size = 0;
+            }
+            if (size > 0 && size + Buffer.byteLength(line) > maxBytes) {
+                renameSync(file, oldFile);
+            }
+            appendFileSync(file, line);
+        }
+        catch (_b) {
+            // Logging must never break the app.
+        }
+    };
+}
+export function copyConsoleTo(write, target = console) {
+    Object.entries(LEVELS).forEach(([method, level]) => {
+        const original = target[method].bind(target);
+        target[method] = (...args) => {
+            original(...args);
+            write(level, args);
+        };
+    });
+}
